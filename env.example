# ============================================================================
#  FARMi · configurazione
#
#  1. Copia questo file e chiamalo  .env   (stessa cartella, senza ".example")
#       macOS / Linux:   cp .env.example .env
#       Windows (cmd):   copy .env.example .env
#  2. Incolla la tua chiave in GEMINI_API_KEY
#  3. Avvia con:  npm start
#
#  Oppure lancia  npm run setup  e il file .env lo crea lui facendoti le domande.
#  Il file .env NON va mai caricato su GitHub (è già escluso da .gitignore).
# ============================================================================

# Porta su cui gira FARMi (http://localhost:3000)
PORT=3000

# ---- Opzione 1 · Google AI Studio (gratis, consigliata) --------------------
# Crea la chiave gratuita qui: https://aistudio.google.com/apikey
# Se la lasci vuota, FARMi usa il server demo online del team (opzione 3).
GEMINI_API_KEY=

# Modello Gemma 4:  gemma-4-26b-a4b-it (più veloce)  oppure  gemma-4-31b-it (più accurato)
GEMMA_MODEL=gemma-4-26b-a4b-it

# ---- Opzione 2 · Ollama: Gemma 4 sul tuo computer, senza chiave -------------
# Installa Ollama (https://ollama.com), poi:  ollama pull gemma4
# Togli il "#" dalle tre righe qui sotto.
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4

# ---- Opzione 3 · Server demo del team (nessuna chiave) ----------------------
# Viene usato in automatico se GEMINI_API_KEY è vuota.
# Per puntare a un altro server togli il "#":
# REMOTE_URL=https://farmi-xxxx.onrender.com

# ---- Protezione della quota gratuita (servono quando il server è pubblico) ---
# RATE_LIMIT_PER_MIN=8
# RATE_LIMIT_PER_DAY=150
# DAILY_CAP=1200

# ---- Avanzate -----------------------------------------------------------------
# Forza il provider: google | ollama | remote  (di solito non serve)
# LLM_PROVIDER=google
# Cartella dei documenti della knowledge base
# KNOWLEDGE_DIR=knowledge
